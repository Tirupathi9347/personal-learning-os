# =============================================================================
# Personal Learning OS — Environment Variables Example
# =============================================================================
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings for production deployment.
# NEVER commit .env or .env.local to GitHub.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase (Database & Authentication) - REQUIRED
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# 2. Key Vault Encryption (AES-256-GCM) - REQUIRED
# -----------------------------------------------------------------------------
# Exactly 32 bytes (or 64-char hex string) used to encrypt API keys in Supabase
ENCRYPTION_SECRET=your-32-byte-secret-or-64-character-hex-string

# -----------------------------------------------------------------------------
# 3. Single-Tenant User Isolation - OPTIONAL (Defaults to user@example.com)
# -----------------------------------------------------------------------------
ALLOWED_USER_EMAIL=user@example.com

# -----------------------------------------------------------------------------
# 4. AI & Gemini Configuration - OPTIONAL (Vault configured in UI preferred)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# 5. Integrations - OPTIONAL (Vault configured in UI preferred)
# -----------------------------------------------------------------------------
GITHUB_PAT=your-github-personal-access-token
LEETCODE_USERNAME=your-leetcode-username

# -----------------------------------------------------------------------------
# 6. Gmail Opportunity Hub OAuth - OPTIONAL
# -----------------------------------------------------------------------------
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret

# -----------------------------------------------------------------------------
# 7. Vercel Cron Job Security - OPTIONAL
# -----------------------------------------------------------------------------
CRON_SECRET=your-random-cron-secret-token
